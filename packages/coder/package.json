{
  "name": "@vt-agent/agent",
  "private": true,
  "bin": {
    "coder": "./src/index.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --target bun --outfile ./dist/index.js --packages external --bundle",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@sinclair/typebox": "^0.34.52",
    "@vt-agent/command-policy": "workspace:*",
    "@vt-agent/git_push": "workspace:*",
    "@vt-agent/standup": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3"
  }
}
